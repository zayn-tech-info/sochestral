# Product Hono API (@sochestral/api) — build from monorepo root
FROM node:22-bookworm-slim AS base

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY scripts ./scripts

# Runtime uses tsx (declared as a package dependency for api + database).
RUN pnpm install --frozen-lockfile --prod

FROM base AS runtime

ENV NODE_ENV=production
ENV PORT=8080
ENV SOCIALMCP_ROOT=/app

COPY --from=deps /app /app

RUN chmod +x /app/scripts/start-api-fly.sh

EXPOSE 8080

CMD ["bash", "/app/scripts/start-api-fly.sh"]
