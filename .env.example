# Product Postgres
# Production / cloud: Neon connection string (set as Fly secret DATABASE_URL on sochestral-api).
# Local agent/dev only: Docker Postgres on host port 5433 (not the live product DB).

DATABASE_URL=postgresql://sochestral:sochestral@localhost:5433/sochestral
TEST_DATABASE_URL=postgresql://sochestral:sochestral@localhost:5433/sochestral_test

# Shared with SocialMCP for HS256 MCP JWTs
JWT_SECRET=dev-change-me-sochestral-jwt

# Product Hono API (default port 8787)
PORT=8787
NEXT_PUBLIC_API_URL=http://localhost:8787
# Absolute API origin used when minting durable media view URLs (calendar/MCP).
# Defaults to NEXT_PUBLIC_API_URL, then http://localhost:$PORT. Production Fly sets
# PUBLIC_API_URL=https://api.sochestral.shop in fly.api.toml.
# PUBLIC_API_URL=http://localhost:8787
# Media view HMAC: production MUST set a dedicated MEDIA_VIEW_SECRET (do not reuse
# JWT_SECRET). Local/dev falls back to JWT_SECRET when unset.
# MEDIA_VIEW_SECRET=
# Web origin(s) for CORS + trusted browser mutations. Comma-separated allowed.
# Outside production, localhost and 127.0.0.1 on the same port are both accepted.
CORS_ORIGIN=http://localhost:3000

# Orchestration provider and SocialMCP HTTP transport
THESEAN_API_KEY=
# THESEAN_MODEL=ship-like/claude-sonnet-5
# THESEAN_INTENT_MODEL=ship-like/claude-sonnet-5
# THESEAN_SETUP_MODEL=ship-like/claude-opus-5
# Cloud product uses the hosted SocialMCP URL. Local default below is for agent/dev only.
SOCIALMCP_MCP_URL=http://127.0.0.1:3334/mcp
# Configure this in the SocialMCP service for browser OAuth return.
# PRODUCT_OAUTH_RETURN_URL=http://localhost:3000/app/settings/connectors
# ORCHESTRATION_CONTEXT_TOKEN_LIMIT=6000
# Tool-heavy schedule turns raise max tokens in code; raise this if text replies truncate.
# ORCHESTRATION_OUTPUT_TOKEN_LIMIT=1500
# ORCHESTRATION_CONTEXT_TOKEN_LIMIT=16000
# ORCHESTRATION_MAX_TOOL_STEPS=4
# ORCHESTRATION_DAILY_RUN_LIMIT=50
# ORCHESTRATION_EXTERNAL_TIMEOUT_MS=15000
# REVIEW_PUBLISH_HOURLY_LIMIT=20
# REVIEW_PUBLISH_TIMEOUT_MS=30000

# Setup agent / business profile (Feature 7). Gate is on unless set to false.
# SETUP_AGENT_ENABLED=false

# Publishing authority rollout (leave false until coordinated SocialMCP smoke checks pass)
PUBLISHING_AUTHORITY_ENABLED=false
# PUBLISHING_CONSENT_VERSION=2026-08-01

# Private Cloudflare R2 image storage (wired in cloud; leave empty for local unless testing uploads)
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# MEDIA_UPLOAD_TICKET_TTL_SECONDS=600
# MEDIA_PREVIEW_TTL_SECONDS=3600
# MEDIA_PUBLISH_TTL_SECONDS=7200
# MEDIA_PENDING_TTL_HOURS=24
# MEDIA_VIEW_TTL_DAYS=30
# MEDIA_UPLOAD_HOURLY_LIMIT=50
# MEDIA_USER_STORAGE_LIMIT_BYTES=1073741824

# THESEAN_TIMEOUT_MS=60000
# ORCHESTRATION_EXTERNAL_TIMEOUT_MS=15000

# Enable only after the configured Thesean model passes the vision smoke test.
THESEAN_VISION_ENABLED=false

# Extended thinking is soft-deprecated: product UI shows action labels only.
# THESEAN_THINKING_ENABLED / THESEAN_THINKING_BUDGET_TOKENS are unused by chat.
# THESEAN_THINKING_ENABLED=false
# THESEAN_THINKING_BUDGET_TOKENS=2048

# Optional: used by `pnpm db:provision` when no email arg is passed
# PROVISION_EMAIL=you@example.com
